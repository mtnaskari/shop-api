# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# MongoDB connection string. With `docker compose up mongo`, use the published port below.
MONGODB_URI=mongodb://shop:shop@127.0.0.1:27018/shop?authSource=admin

# JWT. Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN=*

# Rate limiting: requests per window for the whole API, and for login/register.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Set when running behind a reverse proxy: true, a hop count, or a subnet list.
# TRUST_PROXY=1

# Admin account created by `npm run seed`.
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=admin12345
